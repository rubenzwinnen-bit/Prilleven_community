# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=sb_publishable_...
PLUGPAY_WEBHOOK_BEARER=vervang-door-een-lang-willekeurig-geheim
PLUGPAY_WEBHOOK_SECRET=optioneel-hmac-geheim

# Mail vanuit onze eigen code (api/opzegverzoek.mjs), via de Resend REST API.
# Los van de Resend-sleutel die in Supabase staat voor de auth-mails: die zit
# in de SMTP-instellingen van Supabase en is hier niet bruikbaar.
# Ontbreekt deze sleutel, dan wordt een opzegverzoek nog steeds opgeslagen —
# alleen de mail naar het team gaat dan niet uit.
RESEND_API_KEY=re_...
